# URL donde corre ceNetwork y enlace de retorno a Cerebro Electoral
VITE_CENETWORK_URL=http://localhost:5174
VITE_MAIN_APP_URL=http://localhost:8080/index.html
VITE_MAIN_APP_LABEL=Cerebro Electoral

# Conexión con Backend FastAPI (ceNetwork/backend)
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK=false
VITE_FACEBOOK_FIXTURE=true
VITE_APIFY_MAX_POSTS=20
VITE_API_TOKEN=

# Configuración geográfica y mapa (sin territorio preseleccionado; NO dispara búsqueda automática)
VITE_COUNTRY_CODE=MX
VITE_COUNTRY_NAME=México
VITE_ACTIVE_COUNTRIES=MX
VITE_LEVEL1_LABEL=Estado
VITE_LEVEL2_LABEL=Municipio
VITE_COUNTRY_BOUNDS=-118.45,14.53,-86.7,32.72
VITE_COUNTRY_CENTER=-102.55,23.63
VITE_GLOBE_CENTER=-30,20
VITE_GLOBE_ZOOM=1.1
VITE_WORLD_GEOJSON_URL=geo/world_countries.geojson
VITE_ESTADOS_GEOJSON_URL=geo/mx_estados.geojson
VITE_MUNICIPIOS_URL_TEMPLATE=geo/municipios/{slug}.json
VITE_DEFAULT_THEME=dark
VITE_DEFAULT_TOPIC=Ej. seguridad, agua, bacheo…
VITE_DEFAULT_MODO=tema
