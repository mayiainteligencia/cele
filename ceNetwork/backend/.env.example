# Credenciales de Apify y Gemini (no subir valores reales al repositorio)
APIFY_TOKEN=
GEMINI_API_KEY=

# Control de fuente: fixture | apify (default: fixture)
FUENTE=fixture

# Si es 1, con FUENTE=apify usa solo el caché en disco (sin gastar créditos en demos) y hace fallback al fixture si no existe
FUENTE_CACHE_ONLY=0

# Límite de posts por corrida en Apify (default: 20)
APIFY_MAX_POSTS=20

# Compatibilidad previa (opcional si usas FUENTE)
FACEBOOK_FIXTURE=true
MAX_POST_DAYS=14
MAX_REAL_SEARCHES_PER_HOUR=10
GEMINI_MODEL=gemini-2.5-flash

# Caché (Firestore / respaldo local de 15 minutos)
CACHE_TTL_MINUTES=15
FIRESTORE_COLLECTION=ce_network_cache

# Seguridad y CORS del servidor FastAPI
API_TOKEN=
CORS_ORIGINS=*
PORT=8000


# Modo Persona, fichas, historial y alertas (todos opcionales; valores por defecto entre paréntesis)
# APIFY_MAX_PROFILES=10            # perfiles/páginas que devuelve el paso 1 del modo Persona
# APIFY_PROFILE_SEARCH_TYPE=pages  # searchType del actor: pages-google | pages | profiles | posts | reels
# IDENTIDAD_UMBRAL=40              # puntaje de identidad mínimo (0-100) para llegar a Gemini
# FIRESTORE_ENTIDADES_COLLECTION=entidades
# MONITOREO_MAX_POSTS=10           # tope bajo por ficha en POST /monitoreo/ejecutar (requiere API_TOKEN)
# PICO_DESVIACIONES=3              # desviaciones sobre el promedio de 14 días
# PICO_MIN_POSTS=10
# NARRATIVA_SIMILITUD=0.6          # Jaccard de shingles de 3 palabras
# NARRATIVA_MIN_POSTS=3
# NARRATIVA_MIN_CUENTAS=3
# APIFY_COSTO_POR_RESULTADO_USD=0.005   # solo para el costo ESTIMADO de cada corrida


# Modelos de Gemini con respaldo por cuota (lista ordenada; si uno da 429/503/cuota diaria pasa al siguiente)
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# GEMINI_DESCUBRIR_MODELOS=0       # 1: al arrancar y cada 6 h agrega al final los modelos de la API con generateContent (sin imagen/audio/embeddings/preview)
# LLM_RPM=5                       # peticiones por minuto por modelo; al llenarse pasa al siguiente sin esperar al 429
# LLM_COLA_MAX_S=20                # si todos están llenos y el cupo se libera en menos de esto, espera; si no, avisa
# LLM_TIMEOUT_S=20                 # tiempo máximo por llamada; al vencer pasa al siguiente modelo
# LLM_COOLDOWN_503_S=20            # espera de un modelo tras 503 (saturación, no cuota)
# LLM_LENTO_S=10                   # un modelo que tarda más (o dio 503) pasa al final de la lista LLM_PENAL_S segundos (300)
# LLM_PARALELO_S=8                 # si el modelo tarda más de esto, lanza el siguiente en paralelo (máx. 2) y gana la primera respuesta
# LLM_FALLBACK_PROVIDER=           # punto de extensión (llm.PROVEEDORES_ALTERNOS); apagado por defecto
# LLM_SIMULAR_429=1                # pruebas: el primer modelo responde 429; LLM_SIMULAR_429_MODELOS=N hace fallar los primeros N
# GEMINI_MODELS_ANALISIS=          # opcional: modelos para análisis y radar (si falta usa GEMINI_MODELS)
LLM_COOLDOWN_SECONDS=60            # espera de un modelo agotado por minuto (si es cuota diaria espera hasta medianoche del Pacífico)
LLM_MAX_REINTENTOS=2               # reintentos por error 503 antes de pasar al siguiente modelo
# LLM_SIMULAR_429=1                # prueba: el primer modelo siempre responde 429

# Radar de creadores (YouTube, Instagram, TikTok, Facebook)
APIFY_RADAR_MAX_CONSULTAS=8        # tope de perfiles por grupo en Apify (0 = no consulta Apify); aplica a sugeridos y a medidos de Facebook
YOUTUBE_API_KEY=                   # YouTube Data API v3 (cuota gratuita de 10,000 unidades al día); sin ella YouTube no se mide
YOUTUBE_RADAR_MAX_UNIDADES=500     # tope de unidades de cuota por corrida (un canal ~3; búsqueda por nombre ~103)
# APIFY_ACTOR_INSTAGRAM=apify/instagram-profile-scraper    # entrada: usernames; ~USD 0.0026 por perfil
# APIFY_ACTOR_TIKTOK=clockworks/tiktok-profile-scraper     # entrada: profiles, resultsPerPage; ~USD 0.003 por video
# APIFY_COSTO_IG_USD=0.0026
# APIFY_COSTO_TIKTOK_USD=0.003

# Filtro de tema: puntaje de coincidencia (0-100) mínimo para contar un post; por debajo (y > 0) va a "Por confirmar"
MATCH_UMBRAL=60

# Plataformas adicionales (X, TikTok, Instagram): actor de Apify, tope de resultados por búsqueda y costo por 1,000 resultados (para estimar)
# Entradas verificadas en Apify: apidojo/tweet-scraper (searchTerms, maxItems, sort), clockworks/tiktok-scraper (searchQueries, hashtags, profiles, resultsPerPage),
# apify/instagram-scraper (directUrls, resultsType, resultsLimit, onlyPostsNewerThan)
# APIFY_ACTOR_X=apidojo/tweet-scraper
# APIFY_ACTOR_TIKTOK=clockworks/tiktok-scraper
# APIFY_ACTOR_INSTAGRAM=apify/instagram-scraper
APIFY_MAX_X=30
APIFY_MAX_TIKTOK=30
APIFY_MAX_INSTAGRAM=30
# APIFY_COSTO_X_1000=0.4
# APIFY_COSTO_TIKTOK_1000=3.7
# APIFY_COSTO_INSTAGRAM_1000=2.7
# Actores de perfiles que usa el radar (distintos de los de búsqueda)
# APIFY_ACTOR_RADAR_INSTAGRAM=apify/instagram-profile-scraper
# APIFY_ACTOR_RADAR_TIKTOK=clockworks/tiktok-profile-scraper

# Modo Persona: menciones de terceros y comentarios
APIFY_MAX_PERSONA_FB=15            # tope bajo de posts de Facebook por búsqueda de menciones
APIFY_MAX_COMENTARIOS_POSTS=5      # posts de terceros con más interacción de los que se extraen comentarios
APIFY_MAX_COMENTARIOS=50           # tope de comentarios por plataforma (Facebook y respuestas en X)
# APIFY_ACTOR_FB_COMENTARIOS=apify/facebook-comments-scraper   # entrada: startUrls, resultsLimit, includeNestedComments, onlyCommentsNewerThan; ~USD 0.0025 por comentario
# APIFY_COSTO_COMENTARIO_FB_1000=2.5

# Etiqueta de confianza de la muestra: baja (< MUESTRA_MIN), media (MUESTRA_MIN a 19), alta (20 o más). No oculta cifras: solo etiqueta.
MUESTRA_MIN=5

# Radar de referentes del territorio
APIFY_RADAR_REF_MAX=30             # posts por fuente (TikTok, Instagram y X) al buscar referentes del territorio
RADAR_TIMEOUT_ETAPA_S=30           # tiempo máximo por etapa de Gemini o YouTube; al pasarse se continúa con lo obtenido
RADAR_TIMEOUT_APIFY_S=150          # tiempo máximo por etapa que usa Apify
RADAR_CACHE_FUENTES_H=24           # horas que se reutiliza el resultado de cada fuente de referentes
