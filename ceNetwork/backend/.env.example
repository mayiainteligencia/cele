# Credenciales de Apify y Gemini (no subir valores reales al repositorio)
APIFY_TOKEN=
GEMINI_API_KEY=

# Control de fuente: fixture | apify (default: fixture)
FUENTE=fixture

# Si es 1, con FUENTE=apify usa solo el caché en disco (sin gastar créditos en demos) y hace fallback al fixture si no existe
FUENTE_CACHE_ONLY=0

# Límite de posts por corrida en Apify (default: 20)
APIFY_MAX_POSTS=20

# Compatibilidad previa (opcional si usas FUENTE)
FACEBOOK_FIXTURE=true
MAX_POST_DAYS=14
MAX_REAL_SEARCHES_PER_HOUR=10
GEMINI_MODEL=gemini-2.5-flash

# Caché (Firestore / respaldo local de 15 minutos)
CACHE_TTL_MINUTES=15
FIRESTORE_COLLECTION=ce_network_cache

# Seguridad y CORS del servidor FastAPI
API_TOKEN=
CORS_ORIGINS=*
PORT=8000


# Modo Persona, fichas, historial y alertas (todos opcionales; valores por defecto entre paréntesis)
# APIFY_MAX_PROFILES=10            # perfiles/páginas que devuelve el paso 1 del modo Persona
# APIFY_PROFILE_SEARCH_TYPE=pages  # searchType del actor: pages-google | pages | profiles | posts | reels
# IDENTIDAD_UMBRAL=40              # puntaje de identidad mínimo (0-100) para llegar a Gemini
# FIRESTORE_ENTIDADES_COLLECTION=entidades
# MONITOREO_MAX_POSTS=10           # tope bajo por ficha en POST /monitoreo/ejecutar (requiere API_TOKEN)
# PICO_DESVIACIONES=3              # desviaciones sobre el promedio de 14 días
# PICO_MIN_POSTS=10
# NARRATIVA_SIMILITUD=0.6          # Jaccard de shingles de 3 palabras
# NARRATIVA_MIN_POSTS=3
# NARRATIVA_MIN_CUENTAS=3
# APIFY_COSTO_POR_RESULTADO_USD=0.005   # solo para el costo ESTIMADO de cada corrida
